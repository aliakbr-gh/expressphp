Options -Indexes
RewriteEngine On
DirectoryIndex index.php index.html

# Deny hidden files regardless of whether they exist.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Preserve Bearer and Basic Authorization headers through Apache rewrites.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Source, storage, CLI, and metadata must never be fetched as files.
# Works when the project folder is the subdomain document root
# (for example public_html for digi.example.com).
RewriteRule ^(?:\.git|public|cli|AGENTS\.md|LICENSE|README\.md|PROJECT\.md|app|config|migrations|routes|src|storage)(?:/|$) - [F,L,NC]

# Every other URL, including /api/v1/..., enters the front controller.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]

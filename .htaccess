Options -Indexes
RewriteEngine On

# Deny hidden files such as .env and .git regardless of whether they exist.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Preserve Bearer and Basic Authorization headers through Apache rewrites.
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

# Source, storage, CLI, metadata, and the public/ copy of the front controller
# must never be fetched as files. This applies in local MAMP and production.
RewriteRule ^(?:\.git|public|cli|AGENTS\.md|LICENSE|README\.md|app|config|migrations|routes|seeders|src|storage)(?:/|$) - [F,L,NC]

# Starter HTML client. Everything else is the front controller, even if a file exists.
RewriteRule ^tests(?:/|$) - [L]
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]

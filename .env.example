APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
CORS_ORIGINS=http://localhost

PASSWORD_BCRYPT_COST=10

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3305
DB_DATABASE=expressphp_db
DB_USERNAME=root
DB_PASSWORD=root

JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-bytes
JWT_ISSUER=expressphp
JWT_AUDIENCE=expressphp-api
JWT_TTL=3600
JWT_LEEWAY=5

MAIL_ENABLED=false
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME=ExpressPHP
MAIL_TIMEOUT=10

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Gmail requires 2-Step Verification and a Google App Password.
GMAIL_USERNAME=your-account@gmail.com
GMAIL_APP_PASSWORD=

# Maximum uploaded file size in bytes (10 MB by default).
UPLOAD_MAX_SIZE=10485760

# Uncomment these when the reporting connection is enabled in config/app.php.
# REPORTING_DB_HOST=127.0.0.1
# REPORTING_DB_PORT=3306
# REPORTING_DB_DATABASE=reporting
# REPORTING_DB_USERNAME=root
# REPORTING_DB_PASSWORD=

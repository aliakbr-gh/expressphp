# Used when the domain's document root points directly at /public (most secure setup).

# No directory listings; no content negotiation (it can bypass the rewrite below).
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass the Authorization header through to PHP; CGI/FastCGI setups drop it (needed for Bearer tokens).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve real files directly; send every other URL to index.php (the front controller).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
